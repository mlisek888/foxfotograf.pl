---
layout: base.njk
---
<div class="page-head">
  <div class="wrap">
    <a class="back" href="/aktualnosci/">← Aktualności</a>
    <h1>{{ title }}</h1>
    <p><time datetime="{{ page.date | dataISO }}">{{ page.date | dataPL }}</time></p>
  </div>
</div>
<article class="article">
  <div class="wrap">
    <div class="prose">
      {%- if zdjecie %}<img class="cover" src="{{ zdjecie }}" alt="{{ title }}" sizes="(max-width: 760px) 100vw, 720px" loading="eager">{% endif %}
      {{ content | safe }}
      <hr>
      <p><a class="btn btn-red" href="/#kontakt">Zapytaj o termin</a></p>
    </div>
  </div>
</article>
