<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if title and page.url != "/" %}{{ title }} | FoxFotograf{% else %}{{ site.tytul }}{% endif %}</title>
<meta name="description" content="{{ opis or site.opis }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{% if layout == 'wpis.njk' %}article{% else %}website{% endif %}">
<meta property="og:locale" content="pl_PL">
<meta property="og:site_name" content="FoxFotograf">
<meta property="og:title" content="{{ title or site.tytul }}">
<meta property="og:description" content="{{ opis or site.opis }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/og.jpg">
<meta name="theme-color" content="#EEE6D5">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preload" href="/fonts/fraunces-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/manrope-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/style.css">
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"ProfessionalService","name":"FoxFotograf – Marcin Lis","url":"{{ site.url }}","image":"{{ site.url }}/og.jpg","telephone":"+48{{ strona.kontakt.telefon | replace(' ', '') }}","email":"{{ strona.kontakt.email }}","address":{"@type":"PostalAddress","streetAddress":"{{ strona.kontakt.adres_ulica | replace('ul. ', '') }}","postalCode":"63-750","addressLocality":"Sulmierzyce","addressRegion":"wielkopolskie","addressCountry":"PL"},"areaServed":["Sulmierzyce","Krotoszyn","Milicz","Wielkopolska"],"description":"{{ site.opis }}"}
</script>
</head>
<body>
<a class="hp skip" href="#tresc">Przejdź do treści</a>
<header class="hdr" id="top">
  <div class="wrap">
    <a class="logo" href="/" aria-label="Fox Fotograf – strona główna">{% include "logo.svg" %}<span class="wm"><b>Fox <i>Fotograf</i></b><span>Marcin Lis</span></span></a>
    <nav class="nav" aria-label="Główne menu">
      <a href="/#slub">Ślub</a>
      <a href="/#komunia">Komunie</a>
      <a href="/#sesje">Studio</a>
      <a href="/#fotobudki">Fotobudki</a>
      <a href="/#aparat">FoX Aparat</a>
      <div class="dd">
        <button type="button" aria-haspopup="true" aria-expanded="false">Usługi <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.6"/></svg></button>
        <div class="dd-menu">
          <a href="/#uslugi">Zdjęcia do dokumentów<small>Dowód, paszport, prawo jazdy, wiza – od ręki</small></a>
          <a href="/#uslugi">Reprodukcje i renowacja<small>Ratowanie starych fotografii</small></a>
          <a href="/#uslugi">Cyfryzacja kaset VHS<small>Nagrania rodzinne do MP4</small></a>
          <a href="/#uslugi">Fotografia produktowa<small>Packshoty do sklepów i na Allegro</small></a>
        </div>
      </div>
      <a href="/#strefa-klienta">Strefa klienta</a>
    </nav>
    <div class="hdr-cta">
      <a class="hdr-tel" href="tel:{{ strona.kontakt.telefon | telLink }}">{{ strona.kontakt.telefon }}</a>
      <a class="btn" href="/#kontakt">Zapytaj o termin</a>
    </div>
    <button class="burger" type="button" aria-label="Otwórz menu" aria-controls="mnav" aria-expanded="false" id="burger">
      <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true"><path d="M3 8h20M3 13h20M9 18h14" stroke="currentColor" stroke-width="1.7"/></svg>
    </button>
  </div>
</header>

<nav class="mnav" id="mnav" aria-label="Menu mobilne">
  <div class="mnav-top">
    <span class="logo">{% include "logo.svg" %}<span class="wm"><b>Fox <i>Fotograf</i></b></span></span>
    <button type="button" aria-label="Zamknij menu" id="mclose"><svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true"><path d="M6 6l14 14M20 6L6 20" stroke="currentColor" stroke-width="1.7"/></svg></button>
  </div>
  <a class="big" href="/#slub">Ślub</a>
  <a class="big" href="/#komunia">Komunie</a>
  <a class="big" href="/#sesje">Studio</a>
  <a class="big" href="/#fotobudki">Fotobudki</a>
  <a class="big" href="/#aparat">FoX Aparat</a>
  <div class="sub">
    <p>Usługi</p>
    <a href="/#uslugi">Zdjęcia do dokumentów</a>
    <a href="/#uslugi">Reprodukcje i renowacja</a>
    <a href="/#uslugi">Cyfryzacja kaset VHS</a>
    <a href="/#uslugi">Fotografia produktowa</a>
  </div>
  <a class="big" href="/#o-mnie">O mnie</a>
  <a class="big" href="/#strefa-klienta">Strefa klienta</a>
  <div class="foot">
    <a class="btn" href="/#kontakt">Zapytaj o termin</a>
    <a href="tel:{{ strona.kontakt.telefon | telLink }}" style="font-family:var(--f-mono);color:var(--muted);text-align:center;text-decoration:none">tel. {{ strona.kontakt.telefon }}</a>
  </div>
</nav>

<main id="tresc">
{{ content | safe }}
</main>

<footer>
  <div class="wrap">
    <span class="logo" style="gap:10px">{% include "logo.svg" %}<span>© {{ rok }} Fox Fotograf · Marcin Lis · Sulmierzyce</span></span>
    <nav aria-label="Dokumenty">
      <a href="/#o-mnie">O mnie</a>
      <a href="/aktualnosci/">Aktualności</a>
      <a href="/regulamin/">Regulamin</a>
      <a href="/polityka-prywatnosci/">Polityka prywatności</a>
      <a href="/rodo-fotobudka/">RODO fotobudka</a>
      <a href="/potwierdzenie-rezerwacji/">Potwierdzenie rezerwacji</a>
    </nav>
  </div>
</footer>
<script src="/js/main.js" defer></script>
</body>
</html>
